<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- Se a porta do frontend mudar, ajuste o destino abaixo. -->
    <proxy reverseRewriteHostInResponseHeaders="false" preserveHostHeader="true" />
    <rewrite>
      <rules>
        <rule name="ReverseProxyParaNext" stopProcessing="true">
          <match url="(.*)" />
          <action
            type="Rewrite"
            url="http://127.0.0.1:3003/{R:1}"
            appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
