{
  "name": "caoa-venda-cantada-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --transpile-only --no-notify --respawn src/server.ts",
    "predev": "pnpm prisma:generate && pnpm prisma:migrate:deploy",
    "build": "tsc -p tsconfig.json",
    "prestart": "pnpm prisma:migrate:deploy",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "pnpm prisma:generate && pnpm prisma:migrate:deploy && tsx prisma/seed.ts",
    "db:catalog:changan": "tsx prisma/seed-changan.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.17",
    "@types/node": "^20.14.4",
    "ts-node-dev": "^2.0.0",
    "tsx": "^3.5.0",
    "typescript": "^5.5.4"
  }
}
