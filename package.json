{
  "name": "caoa-venda-cantada-dash",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d",
  "scripts": {
    "dev": "pnpm --filter caoa-venda-cantada-web dev",
    "dev:backend": "pnpm --filter caoa-venda-cantada-api dev",
    "build": "pnpm --filter caoa-venda-cantada-web build",
    "build:backend": "pnpm --filter caoa-venda-cantada-api build",
    "build:production": "pnpm --filter caoa-venda-cantada-api build && pnpm --filter caoa-venda-cantada-web build",
    "start": "node scripts/start-production.mjs",
    "start:api": "pnpm --filter caoa-venda-cantada-api start",
    "start:web": "pnpm --filter caoa-venda-cantada-web start",
    "lint": "pnpm --filter caoa-venda-cantada-web lint",
    "db:seed": "pnpm --dir backend db:seed",
    "db:catalog:changan": "pnpm --dir backend db:catalog:changan",
    "db:studio": "pnpm --dir backend db:studio",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml --env-file .env.production down",
    "service:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/install-production-task.ps1 -StartNow",
    "service:start": "powershell -NoProfile -Command \"Start-ScheduledTask -TaskName 'CAOA Venda Cantada Dashboard'\"",
    "service:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/stop-production-task.ps1",
    "service:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/show-production-status.ps1",
    "service:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/uninstall-production-task.ps1"
  }
}
